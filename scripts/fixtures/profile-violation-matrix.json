  "crateCases": [
    {
      "name": "conformant dialog-shaped crate (explicit schema)",
      "profile": {
        "slug": "matrix",
        "schema": { "type": "object", "required": ["title"], "properties": { "title": { "type": "string" } } },
        "entityRules": [],
